# ---------------------------------------------------------------------------
# NEXUS — frontend environment template
# Copy to `.env.local` and fill in real values. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Base URL of the NEXUS backend.
# Leave empty in development to use the Vite dev proxy (/api -> 127.0.0.1:8000).
# In production set the deployed backend URL, e.g. https://nexus-api.onrender.com
VITE_API_BASE_URL=
