# ---------------------------------------------------------------------------
# NEXUS — backend environment template
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_VERSION=1.0.0

# --- Google Gemini (LLM + optional Google Search grounding) ----------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any tool-calling capable Gemini model works. Free-tier quotas are counted
# per model per day, so switching models is the quickest way around a 429.
#   gemini-2.5-flash        (default, stable)
#   gemini-3.5-flash        (newer, separate quota bucket)
#   gemini-flash-lite-latest (cheapest / fastest)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.35

# --- Search provider ------------------------------------------------------
# google_grounding : real Google Search through Gemini grounding.
#                     Needs only GEMINI_API_KEY, but the Google Search quota
#                     is shared across the whole project.
# duckduckgo        : keyless web search (title/url/snippet) - no extra quota.
# serper            : https://serper.dev  (SERPER_API_KEY required)
# tavily            : https://tavily.com  (TAVILY_API_KEY required)
SEARCH_PROVIDER=google_grounding
MAX_SEARCH_RESULTS=8
SEARCH_TIMEOUT_SECONDS=30
MAX_URL_RESOLUTIONS=10
SERPER_API_KEY=
TAVILY_API_KEY=

# --- Agent ----------------------------------------------------------------
MAX_AGENT_ITERATIONS=6
AGENT_REQUEST_TIMEOUT_SECONDS=180
MAX_QUERY_LENGTH=4000
MAX_HISTORY_MESSAGES=12

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CORS_ALLOW_CREDENTIALS=true

# --- Storage ---------------------------------------------------------------
PERSISTENCE_ENABLED=true
STORE_DIR=data
